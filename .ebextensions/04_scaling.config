# Run exactly one instance. The default (1-4, scaling on NetworkOut) kept adding instances while
# the Weiss fetch timer uploaded card images to S3, and every new instance started its own fetch.
# The timer is installed on every instance, so raise MaxSize only after making it run on just one.
option_settings:
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 1
