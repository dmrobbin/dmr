# System packages needed to build the mysqlclient Python package on the server.
#
# These are installed from "commands" rather than the "packages" key because
# "packages" always runs first and its "yum makecache" gets OOM-killed on a
# t3.micro (1 GB RAM). Commands run in name order, so swap is added before dnf.
commands:
  01_swap:
    command: |
      if [ ! -f /swapfile ]; then
        dd if=/dev/zero of=/swapfile bs=1M count=1024
        chmod 600 /swapfile
        mkswap /swapfile
      fi
      swapon --show | grep -q /swapfile || swapon /swapfile
      grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
  02_build_deps:
    command: dnf install -y gcc pkgconf-pkg-config mariadb105-devel python3.13-devel
    # Skip dnf entirely (and its repo metadata download) once everything is installed.
    test: "! rpm -q gcc pkgconf-pkg-config mariadb105-devel python3.13-devel"
