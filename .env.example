# Local development values. Copy this file to .env (gitignored) and settings.py
# loads it automatically. Never commit real secrets.
DJANGO_DEBUG=1
# --- Production (set these in the Elastic Beanstalk environment, not in git) ---
# DJANGO_SECRET_KEY=<long random string>
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# DB_NAME=... DB_USER=... DB_PASSWORD=... DB_HOST=... DB_PORT=3306
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-west-2
# JSEARCH_API_KEY=<from openwebninja.com>
# SERPAPI_API_KEY=<from serpapi.com>
# JOB_MIN_SALARY=90000
