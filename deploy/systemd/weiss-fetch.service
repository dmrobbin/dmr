# Refresh prices for saved Weiss Schwarz sets last priced over 20 hours ago (TCGCSV updates daily).
# It no longer looks for new sets; run go_time.sh fetch_new_sets by hand when one comes out.
# Started by weiss-fetch.timer; installed by .platform/hooks/postdeploy/02_weiss_fetch_timer.sh.
[Unit]
Description=Refresh Weiss Schwarz prices
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Leading "-": a failed run is logged but still counts as finished, so the timer keeps going.
ExecStart=-/bin/bash /var/app/current/go_time.sh fetch_new_sets --prices-only
StandardOutput=append:/var/log/weiss-fetch.log
StandardError=append:/var/log/weiss-fetch.log
# Every set's prices can take a while; don't let systemd's default 90s timeout kill it.
TimeoutStartSec=8h
# Background job: give the web server priority for CPU and disk.
Nice=10
IOSchedulingClass=idle
